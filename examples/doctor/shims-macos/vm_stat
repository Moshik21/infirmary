#!/usr/bin/env python3
"""A fake `vm_stat` that prints what the fixture wrote under $INFIRMARY_MAC_DIR (see ../fixture.py)."""
import os
import sys

d = os.environ["INFIRMARY_MAC_DIR"]
name = "vm_stat"
if name == "sysctl":
    key = sys.argv[-1]
    path = os.path.join(d, "sysctl.%s" % key)
else:
    path = os.path.join(d, name + ".txt")
try:
    sys.stdout.write(open(path).read())
except OSError:
    sys.exit(1)
