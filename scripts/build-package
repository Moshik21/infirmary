#!/usr/bin/env python3
"""Build the distributable archive: dist/infirmary-<version>.zip

    python3 scripts/build-package [--out DIR] [--denylist FILE ...]

Runs scripts/self-audit first and REFUSES to package on any finding (pass the denylists that live
outside the repository; `--denylist` can be repeated and every file reaches the audit). The zip holds only the product (commands, package, docs, examples, licence,
contributing, security and support notes; not the migration guide for the old names) under one top-level folder, so it unzips cleanly on Windows, macOS
and Linux. It never includes adapters for specific tools, scripts, tests or anything ignored by git.
The Windows launchers are written with CRLF line endings and the POSIX launchers are marked
executable. Same input, same bytes: every entry is stamped with one fixed time, SOURCE_DATE_EPOCH when set, else the commit time of HEAD, else (not a git
checkout, e.g. an unzipped source tree) 1980-01-01, so two clones of the same commit give the same zip, whatever the files' mtimes. The build prints the stamp.
Standard library only.
"""
import argparse
import os
import re
import subprocess
import sys
import time
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
INCLUDE = ["README.md", "LICENSE", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "SUPPORT.md", "CODE_OF_CONDUCT.md", "bin", "src", "docs", "examples"]
SKIP_PARTS = {"__pycache__", ".git", "dist", "runtime"}
EXEC = {"bin/stall-explain", "bin/infirmary"}


def version():
    return re.search(r'VERSION = "([^"]+)"', (ROOT / "src" / "infirmary" / "__init__.py").read_text()).group(1)


def files():
    out = []   # entries sorted by name parts, case-sensitively: sorted(Path) folds case on Windows and would order the zip differently there
    for item in INCLUDE:
        path = ROOT / item
        if path.is_file():
            out.append(path)
        elif path.is_dir():
            out += [p for p in sorted(path.rglob("*"), key=lambda p: p.relative_to(ROOT).parts) if p.is_file() and not (SKIP_PARTS & set(p.relative_to(ROOT).parts)) and p.suffix != ".pyc"]
    return out


def stamp_epoch():
    """The one time every zip entry carries: not the working tree's mtimes, which differ between clones of the same commit."""
    if os.environ.get("SOURCE_DATE_EPOCH", "").strip():
        return max(int(os.environ["SOURCE_DATE_EPOCH"]), 315532800)
    try:
        git = lambda *a: subprocess.run(["git", "-C", str(ROOT), *a], capture_output=True, text=True, check=True).stdout.strip()
        if Path(git("rev-parse", "--show-toplevel")).resolve() == ROOT:  # ROOT itself is the checkout, not a folder inside another repository
            return max(int(git("log", "-1", "--format=%ct", "HEAD")), 315532800)
    except (OSError, ValueError, subprocess.CalledProcessError):
        pass
    return 315532800  # 1980-01-01, the earliest time a zip entry can hold (earlier epochs are raised to it)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--out", default=str(ROOT / "dist"))
    ap.add_argument("--denylist", action="append", default=[], help="names that must not ship (kept outside the repository); can be repeated")
    args = ap.parse_args()
    audit = [sys.executable, str(ROOT / "scripts" / "self-audit")] + [a for d in args.denylist for a in ("--denylist", d)]
    res = subprocess.run(audit)
    if res.returncode != 0:
        print("build-package: refusing to package, the self-audit found problems", file=sys.stderr)
        return 1
    if not args.denylist:
        print("build-package: warning, no --denylist given; personal names were not checked", file=sys.stderr)
    top = "infirmary-%s" % version()
    out_dir = Path(args.out)
    out_dir.mkdir(parents=True, exist_ok=True)
    target = out_dir / (top + ".zip")
    epoch = stamp_epoch()
    stamp = time.gmtime(epoch)[:6]
    print("entry time " + time.strftime("%Y-%m-%d %H:%M:%SZ", time.gmtime(epoch)))
    with zipfile.ZipFile(target, "w", zipfile.ZIP_DEFLATED) as zf:
        for path in files():
            rel = path.relative_to(ROOT).as_posix()
            data = path.read_bytes()
            if rel.endswith(".cmd"):
                data = data.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
            info = zipfile.ZipInfo("%s/%s" % (top, rel), date_time=stamp)
            info.compress_type = zipfile.ZIP_DEFLATED
            info.create_system = 3   # the same "made on Unix" header from any OS (zipfile writes 0 on Windows), as the permissions below say
            info.external_attr = (0o755 if rel in EXEC else 0o644) << 16
            zf.writestr(info, data)
    print("%s (%d KiB, %d files)" % (target, target.stat().st_size // 1024, len(files())))
    return 0


if __name__ == "__main__":
    sys.exit(main())
